# Public Supabase project URL (Project Settings > API).
NEXTPUBLICSUPABASEURL=
# Public publishable key (sb_publishable_...), NOT sb_secret_ or service_role.
# A legacy anon key is supported; a service_role JWT is explicitly rejected.
NEXTPUBLICSUPABASEPUBLISHABLEKEY=
# Exact application origin. Use your HTTPS domain in Vercel.
NEXTPUBLICSITEURL=http://localhost:3000
